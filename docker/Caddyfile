{
	# One process, plain HTTP: TLS is terminated by the platform's proxy.
	admin off
	auto_https off
	persist_config off
	frankenphp {
		num_threads 4
		max_threads 8
	}
}

:{$PORT:8080} {
	root * /app/public
	encode zstd gzip

	# Static files bypass Laravel, so they get the basic hardening header here.
	header X-Content-Type-Options nosniff

	# Static files bypass Laravel, so they get the basic hardening header here.
	header X-Content-Type-Options nosniff

	# Vite's content-hashed files never change under the same name.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# Existing files in public/ are served directly; everything else goes to Laravel (index.php).
	php_server
}
