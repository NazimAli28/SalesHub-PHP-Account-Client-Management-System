# Copy to .env.local and adjust. Only variables prefixed with VITE_ reach the browser,
# so never put secrets here.

# API origin. Leave empty when the SPA and API share an origin (production) or when the
# Vite dev server proxies /api and /sanctum to php artisan serve (development).
VITE_API_URL=

# Show "Sign in as Admin / Support / Team Lead / Sales Executive" buttons on the login page.
# Only for the public demo with seeded, fictional accounts. Never enable it with real data.
VITE_DEMO_MODE=false
