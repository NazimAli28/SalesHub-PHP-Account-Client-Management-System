# Static browser demo (GitHub Pages): `npm run build:demo` builds with these values.
# The API runs in the browser (src/demo, an MSW service worker); there is no server.
VITE_STATIC_DEMO=true
VITE_DEMO_MODE=true
# The Pages site lives under the repository name. Keep both values in sync.
VITE_BASE_PATH=/SalesHub-PHP-Account-Client-Management-System/
VITE_API_URL=/SalesHub-PHP-Account-Client-Management-System
