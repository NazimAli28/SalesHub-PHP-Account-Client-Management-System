# Isolated environment for the Playwright suite (frontend/e2e). It is NOT read by Laravel directly:
# frontend/e2e/support/start-api.mjs sets the same values as process environment variables and then
# runs `php artisan migrate:fresh --seed` and PHP's built-in server on port 8001.
# Copy to `.env.e2e` only if you want to start the e2e API by hand with APP_ENV=e2e.
APP_NAME=SalesHub
APP_ENV=e2e
APP_KEY=base64:ZTJlLWtleS1mb3ItbG9jYWwtdGVzdHMtb25seS0hISE=
APP_DEBUG=false
APP_URL=http://localhost:8001

DB_CONNECTION=sqlite
DB_DATABASE=database/e2e.sqlite

BCRYPT_ROUNDS=4
LOG_CHANNEL=stderr
LOG_LEVEL=error

SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_SAME_SITE=lax
CACHE_STORE=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
BROADCAST_CONNECTION=log

FRONTEND_URL=http://localhost:5174
SANCTUM_STATEFUL_DOMAINS=localhost:5174,127.0.0.1:5174,localhost:8001,127.0.0.1:8001
IP_ALLOWLIST_ENABLED=false
PUBLIC_API_DOCS=false
DEMO_MODE=false
