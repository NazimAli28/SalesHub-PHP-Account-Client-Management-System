# See docs/deployment.md (Docker image, Render demo with SQLite, MySQL deployment). The image defaults to
# SQLite, QUEUE_CONNECTION=sync and a self-generated APP_KEY in demo mode; the values below are for a MySQL deployment.
# SalesHub production settings (single container: Laravel serves /api/* and the built SPA on one origin).
# Copy to the platform's environment variables (or .env), replace every <placeholder>, then run
# `php artisan key:generate --show` once and set APP_KEY. Never commit real values.

APP_NAME=SalesHub
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://<your-host>

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=mysql
DB_HOST=<db-host>
DB_PORT=3306
DB_DATABASE=saleshub
DB_USERNAME=<db-user>
DB_PASSWORD=<db-password>

# Encrypted, httpOnly, Secure, SameSite=Lax cookies; sessions in the database so users can see and
# end their other sessions.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Sanctum treats requests from these hosts as the first-party SPA (host[:port], no scheme).
SANCTUM_STATEFUL_DOMAINS=<your-host>
# CORS allowlist (comma-separated origins). Same origin in production, so this is APP_URL.
# There is no localhost fallback in production.
FRONTEND_URL=${APP_URL}

# IPs or CIDR ranges of the platform's reverse proxy / load balancer, comma-separated, e.g. 10.0.0.0/8.
# They decide which X-Forwarded-For / X-Forwarded-Proto headers are believed (client IP for rate
# limits, the audit log and the IP allowlist; HTTPS detection for Secure cookies and HSTS).
# WARNING: never use * unless the proxy is the only thing that can reach the app (no public port on
# the container); otherwise any client can spoof its IP address and get around the rate limits.
TRUSTED_PROXIES=<platform-proxy-cidr>

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Imports and payment reminders run on the queue: run `php artisan queue:work` next to the web server,
# and `php artisan schedule:run` every minute (or `schedule:work`) for reminders, pruning and the demo reset.
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=<smtp-host>
MAIL_PORT=587
MAIL_USERNAME=<smtp-user>
MAIL_PASSWORD=<smtp-password>
MAIL_FROM_ADDRESS="noreply@<your-host>"
MAIL_FROM_NAME="${APP_NAME}"

# Office-network allowlist for sales executives and team leads (off for the public demo).
IP_ALLOWLIST_ENABLED=false
IP_ALLOWLIST=

# The API reference at /docs/api lists endpoints only (every endpoint still needs a session).
PUBLIC_API_DOCS=true
SCRAMBLE_DEV_TOOLS=false

# Public demo: shared demo accounts are protected from lock-outs, sessions and IPs of other visitors
# are hidden, and `demo:reset` rebuilds the database every hour. Set to false for a real deployment.
DEMO_MODE=true
# DEMO_USERNAMES=admin,support,support2,tl,tl2,tl3,tl4,agent1,agent2,agent3,agent4,agent5,agent6,agent7

# Audit-log retention (activitylog:clean, daily) and never-started import uploads (model:prune, daily).
ACTIVITY_LOG_RETENTION_DAYS=180
IMPORTS_PRUNE_AFTER_HOURS=24
